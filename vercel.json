{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "functions": {
    "server.ts": {
      "includeFiles": "dist/**"
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/contact-rate-limit-cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
